# Copy this file to .env and fill in the values.
# .env is gitignored; this file is committed, so it must never contain real secrets.

# Lets the gateway call Anthropic. Create one at console.anthropic.com,
# and set a spend limit before the first request.
ANTHROPIC_API_KEY=

# Lets your own code authenticate to your gateway. Must start with "sk-".
# Generate one straight into .env without printing it to the screen:
#   echo "LITELLM_MASTER_KEY=sk-$(openssl rand -hex 24)" >> .env
LITELLM_MASTER_KEY=
